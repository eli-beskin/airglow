#!/usr/bin/env bash
# airglow-fx — switch the lighting effect: airglow-fx stars | cats | eq | status
set -euo pipefail
EFFECTS=(stars cats eq)

case "${1:-status}" in
    stars|cats|eq)
        for fx in "${EFFECTS[@]}"; do
            [[ "$fx" == "$1" ]] || systemctl --user disable --now "airglow-$fx.service" 2>/dev/null || true
        done
        systemctl --user enable --now "airglow-$1.service"
        echo "Lighting: $1 (stays after the next login)"
        ;;
    status)
        for fx in "${EFFECTS[@]}"; do
            printf '%-6s %-9s %s\n' "$fx" \
                "$(systemctl --user is-active "airglow-$fx.service" || true)" \
                "$(systemctl --user is-enabled "airglow-$fx.service" 2>/dev/null || true)"
        done
        ;;
    *)
        echo "Usage: airglow-fx stars | cats | eq | status" >&2
        exit 1
        ;;
esac
