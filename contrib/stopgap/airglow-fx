#!/usr/bin/env bash
# airglow-fx — switch the stopgap lighting effect.
#
#   airglow-fx stars | cats | eq   switch to an effect (stays after the next login)
#   airglow-fx on                  turn on the last used effect (stars the first time)
#   airglow-fx off                 turn the lighting off and black (stays after the next login)
#   airglow-fx current             print the running effect, or "off"
#   airglow-fx status              table of all effects
#
# The GNOME Quick Settings toggle (contrib/gnome-extension) calls this script,
# so the switching logic lives in one place and works the same from a terminal.
set -euo pipefail
EFFECTS=(stars cats eq)

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/airglow"
LAST_FILE="$STATE_DIR/last-effect"
# While this file exists, a stopping effect paints the LEDs black whatever its
# ON_EXIT says (stars defaults to ON_EXIT=static, which would leave a solid color).
OFF_FLAG="${XDG_RUNTIME_DIR:-/tmp}/airglow/off-requested"

is_effect() {
    local fx
    for fx in "${EFFECTS[@]}"; do [[ "$fx" == "$1" ]] && return 0; done
    return 1
}

current() {
    local fx state
    for fx in "${EFFECTS[@]}"; do
        state="$(systemctl --user is-active "airglow-$fx.service" 2>/dev/null || true)"
        case "$state" in
            active|activating|reloading) echo "$fx"; return ;;
        esac
    done
    echo off
}

last_effect() {
    local fx=""
    [[ -r "$LAST_FILE" ]] && fx="$(<"$LAST_FILE")"
    if is_effect "$fx"; then echo "$fx"; else echo "${EFFECTS[0]}"; fi
}

switch_to() {
    local target="$1" fx
    rm -f "$OFF_FLAG"
    for fx in "${EFFECTS[@]}"; do
        [[ "$fx" == "$target" ]] || systemctl --user disable --now "airglow-$fx.service" 2>/dev/null || true
    done
    systemctl --user enable --now "airglow-$target.service"
    mkdir -p "$STATE_DIR"
    echo "$target" > "$LAST_FILE"
    echo "Lighting: $target (stays after the next login)"
}

turn_off() {
    local fx
    mkdir -p "$(dirname "$OFF_FLAG")"
    touch "$OFF_FLAG"
    # 'systemctl stop' waits until the process has exited, so the effect has
    # already read the flag when we remove it below.
    for fx in "${EFFECTS[@]}"; do
        systemctl --user disable --now "airglow-$fx.service" 2>/dev/null || true
    done
    rm -f "$OFF_FLAG"
    echo "Lighting: off (stays after the next login)"
}

case "${1:-status}" in
    stars|cats|eq)
        switch_to "$1"
        ;;
    on)
        switch_to "$(last_effect)"
        ;;
    off)
        turn_off
        ;;
    current)
        current
        ;;
    status)
        for fx in "${EFFECTS[@]}"; do
            printf '%-6s %-9s %s\n' "$fx" \
                "$(systemctl --user is-active "airglow-$fx.service" || true)" \
                "$(systemctl --user is-enabled "airglow-$fx.service" 2>/dev/null || true)"
        done
        ;;
    *)
        echo "Usage: airglow-fx stars | cats | eq | on | off | current | status" >&2
        exit 1
        ;;
esac
